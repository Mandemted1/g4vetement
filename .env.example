# Copy to .env.local and fill in (Supabase Dashboard > Project Settings > API).
# .env.local is git-ignored. NEVER commit the service role key or expose it to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: lets `npm run migrate` apply SQL for you (Supabase > Connect > Session pooler URI)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="G4 <orders@yourdomain.com>"
EMAIL_REPLY_TO=you@yourdomain.com
STORE_ADDRESS="Your business name, street, city, state, ZIP"
NEXT_PUBLIC_SITE_URL=http://localhost:3100
RESEND_WEBHOOK_SECRET=whsec_xxx
CRON_SECRET=make-up-a-long-random-string

# Email without a domain: Gmail with an App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=yourstore@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM_NAME=G4
# EMAIL_PROVIDER=smtp   # or "resend"; by default Gmail is used when its vars are set and EMAIL_FROM is not
